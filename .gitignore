Data/
uploads/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

echo node_modules/ > .gitignore
echo __pycache__/ >> .gitignore
echo *.h5 >> .gitignore
echo *.pkl >> .gitignore
echo *.ckpt >> .gitignore
echo *.zip >> .gitignore
echo *.rar >> .gitignore
echo *.tar >> .gitignore
echo *.tar.gz >> .gitignore
echo *.log >> .gitignore
